{
"manifest_version": 3,
"name": "ANS Exam Downloader",
"version": "2.0",
"description": "Easily download your exam result PDFs from ans.app.",
"icons": {
"128": "icon.png"
},
"browser_specific_settings": {
"gecko": {
"id": "Ans-downloader",
"strict_min_version": "109.0"
}
},
"permissions": [
"activeTab",
"scripting"
],
"host_permissions": [
"https://.ans.app/"
],
"action": {
"default_popup": "popup.html",
"default_title": "Download Exam PDF",
"default_icon": {
"128": "icon.png"
}
}
}